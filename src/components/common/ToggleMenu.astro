---
export interface Props {
  label?: string;
  class?: string;
  controls?: string;
}

const {
  label = 'Toggle Menu',
  class: className = 'flex flex-col h-12 w-12 rounded justify-center items-center cursor-pointer group',
  controls,
} = Astro.props;
---

<button
  type="button"
  class={className}
  aria-label={label}
  aria-expanded="false"
  {...controls ? { 'aria-controls': controls } : {}}
  data-aw-toggle-menu
>
  <span class="sr-only">{label}</span>
  <slot>
    <svg aria-hidden="true" viewBox="0 0 24 16" class="h-6 w-6 fill-none stroke-current stroke-2">
      <path
        d="M2 3h20"
        class="transition-transform duration-200 group-[.expanded]:translate-y-5 group-[.expanded]:rotate-45"></path>
      <path
        d="M2 13h20"
        class="transition-transform duration-200 group-[.expanded]:-translate-y-5 group-[.expanded]:-rotate-45"></path>
    </svg>
  </slot>
</button>
