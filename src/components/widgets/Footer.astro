---
import { Icon } from 'astro-icon/components';
import { getHomePermalink, getPermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links?: Array<Links>;
  secondaryLinks?: Array<Link>;
  socialLinks?: Array<Link>;
  footNote?: string;
  theme?: string;
}

const footerLinks = [
  {
    title: 'Savalan Institute',
    links: [
      { text: 'Our Works', href: getHomePermalink() },
      { text: 'Impact Areas', href: getHomePermalink() + '#impact-areas' },
      { text: 'People', href: getPermalink('/landing') },
      { text: 'Blog', href: getPermalink('/blog') },
    ],
  },
  {
    title: 'Connect',
    links: [
      { text: 'Contact', href: getPermalink('/contact') },
      { text: 'Careers', href: getPermalink('/contact') },
      { text: 'Press Room', href: getPermalink('/contact') },
      { text: 'Privacy Policy', href: getPermalink('/privacy') },
    ],
  },
];

const socialLinks = [
  { label: 'LinkedIn', icon: 'tabler:brand-linkedin', href: 'https://www.linkedin.com' },
  { label: 'Facebook', icon: 'tabler:brand-facebook', href: 'https://www.facebook.com' },
  { label: 'X', icon: 'tabler:brand-x', href: 'https://x.com' },
  { label: 'Instagram', icon: 'tabler:brand-instagram', href: 'https://www.instagram.com' },
  { label: 'YouTube', icon: 'tabler:brand-youtube', href: 'https://www.youtube.com' },
];
---

<footer class="w-full overflow-hidden bg-[#034a75] text-white not-prose">
  <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <section aria-labelledby="footer-newsletter-title">
      <h2 id="footer-newsletter-title" class="text-4xl font-bold tracking-tight md:text-5xl">Stay Connected</h2>
      <p class="mt-5 max-w-4xl text-xl leading-relaxed text-white/85 md:text-2xl">
        Get the latest Savalan Institute news, stories and announcements in your inbox
      </p>

      <form class="mt-12" action="/subscribe" method="post">
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
          <label class="block">
            <span class="text-sm font-bold tracking-[0.12em]">EMAIL ADDRESS *</span>
            <input
              class="mt-3 h-14 w-full rounded-lg border border-white/50 bg-transparent px-4 text-lg text-white outline-none transition placeholder:text-white/50 focus:border-white focus:ring-2 focus:ring-white/30"
              type="email"
              name="email"
              autocomplete="email"
              required
            />
          </label>
          <label class="block">
            <span class="text-sm font-bold tracking-[0.12em]">FIRST NAME *</span>
            <input
              class="mt-3 h-14 w-full rounded-lg border border-white/50 bg-transparent px-4 text-lg text-white outline-none transition placeholder:text-white/50 focus:border-white focus:ring-2 focus:ring-white/30"
              type="text"
              name="firstName"
              autocomplete="given-name"
              required
            />
          </label>
          <label class="block">
            <span class="text-sm font-bold tracking-[0.12em]">LAST NAME *</span>
            <input
              class="mt-3 h-14 w-full rounded-lg border border-white/50 bg-transparent px-4 text-lg text-white outline-none transition placeholder:text-white/50 focus:border-white focus:ring-2 focus:ring-white/30"
              type="text"
              name="lastName"
              autocomplete="family-name"
              required
            />
          </label>
          <label class="block">
            <span class="text-sm font-bold tracking-[0.12em]">COUNTRY *</span>
            <select
              class="mt-3 h-14 w-full rounded-lg border border-white/50 bg-[#034a75] px-4 text-lg text-white outline-none transition focus:border-white focus:ring-2 focus:ring-white/30"
              name="country"
              autocomplete="country-name"
              required
            >
              <option value="" selected disabled>Select a country</option>
              <option value="us">United States</option>
              <option value="ca">Canada</option>
              <option value="gb">United Kingdom</option>
              <option value="other">Other</option>
            </select>
          </label>
        </div>
        <button
          class="mt-8 inline-flex items-center rounded-lg border border-white px-7 py-3 text-base font-bold transition hover:bg-white hover:text-[#034a75] focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#034a75]"
          type="submit"
        >
          Subscribe
          <span class="ml-3 text-xl" aria-hidden="true">→</span>
        </button>
      </form>
    </section>
  </div>

  <div class="border-y border-white/10" aria-hidden="true">
    <div class="overflow-hidden whitespace-nowrap py-4">
      <div class="footer-marquee text-7xl font-bold leading-none tracking-[-0.05em] text-white/10 md:text-[12rem]">
        Savalan Institute&nbsp;&nbsp;&nbsp;Savalan Institute&nbsp;&nbsp;&nbsp;
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="grid gap-14 lg:grid-cols-3 lg:gap-20">
      <div class="lg:col-span-1">
        <a
          class="inline-flex items-center transition-opacity hover:opacity-80"
          href={getHomePermalink()}
          aria-label="Savalan Institute home"
        >
          <img
            class="h-auto max-h-16 w-64 object-contain object-left"
            src="/assets/gemini-svg.svg"
            alt="Savalan Institute"
          />
        </a>
        <p class="mt-8 max-w-md text-lg leading-relaxed text-white/85">
          Driving change through dialogue, leadership, and action to help solve the greatest challenges of our time.
        </p>
      </div>

      <nav class="grid gap-10 sm:grid-cols-2 lg:col-span-2 lg:grid-cols-2" aria-label="Footer navigation">
        {
          footerLinks.map((group) => (
            <div>
              <h2 class="text-base font-semibold text-white/60">{group.title}</h2>
              <ul class="mt-5 space-y-4">
                {group.links.map((link) => (
                  <li>
                    <a
                      class="group inline-flex items-center text-lg font-semibold transition-colors hover:text-white/70 focus:outline-none focus-visible:underline"
                      href={link.href}
                    >
                      {link.text}
                      <span
                        class="ml-2 text-xl text-white/60 transition-transform duration-300 group-hover:translate-x-1"
                        aria-hidden="true"
                      >
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="mt-16 flex flex-col gap-6 border-t border-white/20 pt-6 md:flex-row md:items-center md:justify-between">
      <p class="text-sm text-white/75">© 2026 Savalan Institute, some rights reserved</p>
      <ul class="flex flex-wrap items-center gap-2" aria-label="Social media">
        {
          socialLinks.map((social) => (
            <li>
              <a
                class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white transition hover:border-white hover:bg-white hover:text-[#034a75] focus:outline-none focus:ring-2 focus:ring-white"
                href={social.href}
                aria-label={social.label}
                target="_blank"
                rel="noreferrer"
              >
                <Icon name={social.icon} class="h-5 w-5" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer-marquee {
    width: max-content;
    animation: footer-marquee 30s linear infinite;
  }

  @keyframes footer-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-marquee {
      animation-play-state: paused;
    }
  }
</style>
