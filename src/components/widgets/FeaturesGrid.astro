---
import defaultImage from '~/assets/images/default.png';

const cards = [
  {
    title: 'Leadership',
    headline: 'Develop effective communication and grassroots mentoring to guide communities forward.',
    href: '/services',
    cta: 'Explore Leadership',
    image: 'https://images.unsplash.com/photo-1517048676732-d65bc937f952?q=80&w=800&h=1200&fit=crop',
    items: ['Public Speaking', 'Mentorship', 'Team Building'],
  },
  {
    title: 'Policy',
    headline: 'Advocate for robust ethical oversight and equitable standards in emerging technologies.',
    href: '/about',
    cta: 'Explore Policy',
    image: 'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?q=80&w=800&h=1200&fit=crop',
    items: ['Ethical Frameworks', 'Tech Standards', 'Civic Guidelines'],
  },
  {
    title: 'Change',
    headline: 'Mobilize volunteer campaigns and build platforms for direct civic action.',
    href: '/contact',
    cta: 'Explore Change',
    image: 'https://images.unsplash.com/photo-1552664730-d307ca884978?q=80&w=800&h=1200&fit=crop',
    items: ['Volunteer Drives', 'Event Organizing', 'Grassroots Initiatives'],
  },
  {
    title: 'Economy',
    headline: 'Drive sustainable economic growth and financial empowerment.',
    href: '/services',
    cta: 'Explore Economy',
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=800&h=1200&fit=crop',
    items: ['Economic Development', 'Job Creation', 'Financial Literacy'],
  },
];
---

<section id="impact-areas" class="bg-slate-50 px-5 py-16 md:px-8 md:py-24" data-features-grid>
  <div class="mx-auto max-w-7xl">
    <div class="mb-10 max-w-2xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.25em] text-primary">Impact areas</p>
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white md:text-5xl">
        Build momentum for meaningful change.
      </h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
        Explore the work that helps communities lead, shape policy, and create lasting impact.
      </p>
    </div>

    <div
      class="invisible mx-auto mb-10 max-w-4xl opacity-0 transition-opacity duration-700 ease-in-out pointer-events-none"
      data-feature-search
    >
      <form action="/search" method="get" data-feature-search-form>
        <label class="sr-only" for="impact-area-search">Search impact areas</label>
        <div class="relative">
          <input
            id="impact-area-search"
            class="h-16 w-full rounded-lg border border-gray-300 bg-gray-100 px-6 text-lg text-slate-900 shadow-sm outline-none transition focus:ring-2 focus:ring-blue-500 dark:border-gray-300 dark:bg-gray-100 dark:text-slate-900"
            type="search"
            name="q"
            placeholder=""
            autocomplete="off"
            data-feature-search-input
          />
          <span
            class="pointer-events-none absolute inset-y-0 left-6 flex items-center text-lg text-slate-500 opacity-0 transition-opacity duration-500"
            aria-hidden="true"
            data-feature-search-placeholder
          >
            What can we help you find?
          </span>
        </div>
      </form>
    </div>

    <div class="grid grid-cols-2 gap-4 md:hidden" role="list" aria-label="Impact areas">
      {
        cards.map((card, index) => (
          <a
            class="features-grid__mobile-card group relative flex h-72 flex-col justify-between overflow-hidden rounded-2xl bg-cover bg-center bg-no-repeat p-5 text-white opacity-0 shadow-xl motion-safe:animate-[features-grid-rise_700ms_ease-out_both] focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            style={`--card-delay: ${index * 200}ms; background-image: url('${card.image}')`}
            href={card.href}
            role="listitem"
          >
            <span class="relative z-10 break-words text-lg font-semibold tracking-tight hyphens-auto">
              {card.title}
            </span>
            <span
              class="relative z-10 ml-auto inline-flex h-12 w-12 items-center justify-center rounded-full bg-slate-950/60 text-3xl text-white"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        ))
      }
    </div>

    <div
      class="features-grid__desktop hidden h-[600px] min-h-0 w-full flex-row gap-2 overflow-hidden md:flex"
      role="list"
      aria-label="Impact areas"
    >
      {
        cards.map((card, index) => (
          <article
            class="features-grid__card group relative flex min-w-0 flex-1 overflow-hidden rounded-2xl bg-slate-900 text-white opacity-0 shadow-xl transition-all duration-500 ease-in-out motion-safe:animate-[features-grid-rise_700ms_ease-out_both] md:min-h-0"
            style={`--card-delay: ${index * 200}ms`}
            data-feature-card
            role="listitem"
          >
            <span
              class="features-grid__image-panel absolute inset-0 bg-cover bg-center bg-no-repeat transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]"
              style={`background-image: url('${card.image}')`}
              aria-hidden="true"
            />
            <button
              class="features-grid__trigger relative z-10 flex min-h-80 w-full flex-col justify-between bg-transparent p-6 text-left text-shadow-lg transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary md:min-h-0 md:p-8"
              type="button"
              aria-expanded="false"
              data-feature-trigger
            >
              <span class="break-words text-3xl font-semibold tracking-tight hyphens-auto md:text-4xl">
                {card.title}
              </span>
              <span class="flex items-center justify-between text-sm font-medium text-slate-300">
                <span>Explore</span>
                <span
                  aria-hidden="true"
                  class="text-2xl transition-transform duration-500 group-[.is-active]:rotate-45"
                >
                  +
                </span>
              </span>
            </button>

            <div
              class="features-grid__panel pointer-events-none relative z-10 flex min-w-0 flex-1 flex-col bg-white p-6 text-slate-900 opacity-0 transition-all duration-500 ease-in-out md:p-10"
              aria-hidden="true"
              data-feature-panel
            >
              <button
                class="absolute right-4 top-4 inline-flex h-10 w-10 items-center justify-center rounded-full text-2xl text-slate-700 transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                type="button"
                aria-label={`Close ${card.title} details`}
                data-feature-close
              >
                ×
              </button>
              <p class="max-w-xl pr-10 text-2xl font-medium leading-tight md:text-3xl">{card.headline}</p>
              <a
                class="mt-6 inline-flex w-fit items-center rounded-full bg-slate-900 px-5 py-3 font-semibold text-white transition hover:bg-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                href={card.href}
              >
                {card.cta}
                <span aria-hidden="true" class="ml-2">
                  →
                </span>
              </a>
              <ul class="mt-auto grid gap-4 pt-10 sm:grid-cols-3">
                {card.items.map((item) => (
                  <li class="overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
                    <img class="h-24 w-full object-cover" src={defaultImage.src} alt="" loading="lazy" />
                    <span class="flex items-center justify-between gap-2 p-3 text-sm font-medium">
                      {item}
                      <span aria-hidden="true" class="text-lg">
                        →
                      </span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  [data-features-grid] [data-feature-card],
  [data-features-grid] .features-grid__mobile-card {
    animation-delay: var(--card-delay);
  }

  [data-feature-card].is-active {
    flex: 1 1 auto;
  }

  [data-feature-card].is-active .features-grid__image-panel {
    width: 50%;
  }

  [data-feature-card].is-active .features-grid__trigger {
    flex: 0 0 50%;
    width: 50%;
    background-color: transparent;
  }

  [data-feature-card].is-active .features-grid__panel {
    flex: 0 0 50%;
    margin-left: 0;
  }

  [data-feature-card].is-active .features-grid__panel {
    pointer-events: auto;
    opacity: 1;
  }

  @media (min-width: 768px) {
    [data-features-grid] .features-grid__card {
      flex: 0 0 25%;
      min-width: 0;
      transition:
        flex-basis 700ms cubic-bezier(0.25, 1, 0.5, 1),
        width 700ms cubic-bezier(0.25, 1, 0.5, 1);
    }

    [data-features-grid] .features-grid__desktop.has-active .features-grid__card:not(.is-active) {
      flex: 0 0 10%;
    }

    [data-features-grid]
      .features-grid__desktop.has-active
      .features-grid__card:not(.is-active)
      .features-grid__trigger {
      width: 100%;
      overflow: hidden;
      white-space: nowrap;
      padding-inline: 0.5rem;
    }

    [data-features-grid]
      .features-grid__desktop.has-active
      .features-grid__card:not(.is-active)
      .features-grid__trigger
      > span {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      align-self: center;
    }

    [data-features-grid]
      .features-grid__desktop.has-active
      .features-grid__card:not(.is-active)
      .features-grid__image-panel {
      opacity: 0.45;
    }
  }

  @keyframes features-grid-rise {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-features-grid] [data-feature-card],
    [data-features-grid] .features-grid__mobile-card {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  interface FeaturesGridState {
    cleanup: () => void;
    pageLoadHandler: () => void;
  }

  const documentWithState = document as Document & {
    __savalanFeaturesGridState?: FeaturesGridState;
  };

  documentWithState.__savalanFeaturesGridState?.cleanup();
  if (documentWithState.__savalanFeaturesGridState?.pageLoadHandler) {
    document.removeEventListener('astro:page-load', documentWithState.__savalanFeaturesGridState.pageLoadHandler);
  }

  const pageLoadHandler = () => {
    documentWithState.__savalanFeaturesGridState?.cleanup();

    const grid = document.querySelector<HTMLElement>('[data-features-grid]');
    const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('[data-feature-card]')) : [];
    const desktop = grid?.querySelector<HTMLElement>('.features-grid__desktop');
    const cleanups: Array<() => void> = [];

    if (!grid || !cards.length) return;

    const search = grid.querySelector<HTMLElement>('[data-feature-search]');
    const searchInput = search?.querySelector<HTMLInputElement>('[data-feature-search-input]');
    const searchPlaceholder = search?.querySelector<HTMLElement>('[data-feature-search-placeholder]');
    const questions = [
      'What can we help you find?',
      'How can I develop my leadership skills?',
      'Where can I read the latest policy frameworks?',
      'How do I start a volunteer grassroots campaign?',
      'What strategies drive sustainable economic growth?',
      'Where can I find ethical tech standards?',
      'How do we build platforms for civic action?',
      'What are the best practices for financial empowerment?',
      'How can I advocate for equitable policies?',
      'Where are the latest community impact reports?',
    ];
    let searchTimer: number | undefined;
    let rotationTimer: number | undefined;
    let searchPaused = false;

    if (search && searchInput && searchPlaceholder) {
      let questionIndex = 0;
      const clearSearchTimers = () => {
        if (searchTimer !== undefined) window.clearTimeout(searchTimer);
        if (rotationTimer !== undefined) window.clearTimeout(rotationTimer);
        searchTimer = undefined;
        rotationTimer = undefined;
      };

      const pauseSearch = () => {
        searchPaused = true;
        clearSearchTimers();
        searchPlaceholder.classList.add('opacity-0');
      };

      const startRotation = () => {
        clearSearchTimers();
        searchPaused = false;
        searchPlaceholder.textContent = questions[questionIndex];
        searchPlaceholder.classList.remove('opacity-0');

        const finishQuestion = () => {
          if (searchPaused) return;
          searchPlaceholder.classList.add('opacity-0');
          rotationTimer = window.setTimeout(() => {
            if (searchPaused) return;
            questionIndex = (questionIndex + 1) % questions.length;
            searchPlaceholder.textContent = questions[questionIndex];
            searchPlaceholder.classList.remove('opacity-0');
            rotationTimer = window.setTimeout(finishQuestion, 2800);
          }, 3000);
        };

        rotationTimer = window.setTimeout(finishQuestion, 2800);
      };

      searchTimer = window.setTimeout(() => {
        search.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
        search.classList.add('visible', 'opacity-100', 'pointer-events-auto');
        startRotation();
      }, 3000);

      const onSearchFocus = () => pauseSearch();
      const onSearchBlur = () => {
        if (searchInput.value === '') startRotation();
      };
      searchInput.addEventListener('focus', onSearchFocus);
      searchInput.addEventListener('blur', onSearchBlur);
      cleanups.push(() => {
        clearSearchTimers();
        searchInput.removeEventListener('focus', onSearchFocus);
        searchInput.removeEventListener('blur', onSearchBlur);
      });
    }

    const isDesktop = () => window.matchMedia('(min-width: 768px)').matches;
    const closeAll = () => {
      desktop?.classList.remove('has-active');
      cards.forEach((card) => {
        card.classList.remove('is-active');
        card.querySelector<HTMLButtonElement>('[data-feature-trigger]')?.setAttribute('aria-expanded', 'false');
        card.querySelector<HTMLElement>('[data-feature-panel]')?.setAttribute('aria-hidden', 'true');
      });
    };

    cards.forEach((card) => {
      const trigger = card.querySelector<HTMLButtonElement>('[data-feature-trigger]');
      const close = card.querySelector<HTMLButtonElement>('[data-feature-close]');
      const onTriggerClick = () => {
        if (!isDesktop()) return;

        const wasActive = card.classList.contains('is-active');
        closeAll();
        if (!wasActive) {
          desktop?.classList.add('has-active');
          card.classList.add('is-active');
          trigger?.setAttribute('aria-expanded', 'true');
          card.querySelector<HTMLElement>('[data-feature-panel]')?.setAttribute('aria-hidden', 'false');
        }
      };
      const onCloseClick = () => {
        if (isDesktop()) closeAll();
      };

      trigger?.addEventListener('click', onTriggerClick);
      close?.addEventListener('click', onCloseClick);
      cleanups.push(() => {
        trigger?.removeEventListener('click', onTriggerClick);
        close?.removeEventListener('click', onCloseClick);
      });
    });

    const onKeydown = (event: KeyboardEvent) => {
      if (isDesktop() && event.key === 'Escape') closeAll();
    };
    document.addEventListener('keydown', onKeydown);
    cleanups.push(() => document.removeEventListener('keydown', onKeydown));

    documentWithState.__savalanFeaturesGridState = {
      pageLoadHandler,
      cleanup: () => {
        cleanups.forEach((cleanup) => cleanup());
        closeAll();
      },
    };
  };

  document.addEventListener('astro:page-load', pageLoadHandler);
  documentWithState.__savalanFeaturesGridState = {
    pageLoadHandler,
    cleanup: () => undefined,
  };
</script>
