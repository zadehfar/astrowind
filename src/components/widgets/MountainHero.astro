<section
  class="relative isolate min-h-[min(820px,100svh)] overflow-hidden bg-slate-950"
  aria-labelledby="mountain-hero-title"
  data-mountain-hero
>
  <img
    class="absolute inset-0 z-0 h-full w-full object-cover pointer-events-none"
    src="/assets/images/Savalan M.jpg"
    alt=""
    loading="eager"
    fetchpriority="high"
    aria-hidden="true"
  />

  <div
    class="relative z-10 grid min-h-[min(820px,100svh)] place-items-center px-6 pb-16 pt-28 text-center font-sans text-white"
  >
    <div class="relative grid w-full place-items-center">
      <div class="absolute inset-0 grid place-items-center" aria-live="polite">
        <p
          class="pointer-events-none opacity-0 transition-opacity duration-700 ease-in-out text-4xl font-semibold tracking-tight sm:text-5xl md:text-7xl"
          data-hero-phase
        >
          Define Problem
        </p>
        <p
          class="pointer-events-none col-start-1 row-start-1 opacity-0 transition-opacity duration-700 ease-in-out text-4xl font-semibold tracking-tight sm:text-5xl md:text-7xl"
          data-hero-phase
        >
          Exercise Leadership
        </p>
        <p
          class="pointer-events-none col-start-1 row-start-1 opacity-0 transition-opacity duration-700 ease-in-out text-4xl font-semibold tracking-tight sm:text-5xl md:text-7xl"
          data-hero-phase
        >
          Create Impact
        </p>
      </div>

      <div class="text-shadow-lg opacity-0 transition-opacity duration-700 ease-in-out" data-hero-final>
        <p class="text-2xl font-light tracking-wide md:text-3xl">Welcome to</p>
        <h1 class="my-2 text-5xl font-extrabold tracking-tight md:text-7xl" id="mountain-hero-title">
          Savalan Institute
        </h1>
        <p class="text-2xl font-medium tracking-wide md:text-3xl" data-hero-join>Join US</p>
      </div>
    </div>
  </div>
</section>

<style>
  [data-mountain-hero] [data-hero-final] {
    transform: translateY(0.75rem);
    text-shadow: 0 2px 18px rgb(0 0 0 / 28%);
  }

  [data-mountain-hero].is-final [data-hero-final] {
    opacity: 1;
    transform: translateY(0);
  }

  [data-mountain-hero].is-final [data-hero-join] {
    animation: mountain-hero-join-in 500ms 650ms both ease-out;
  }

  @keyframes mountain-hero-join-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-mountain-hero] [data-hero-final] {
      transform: none;
      transition: none;
    }

    [data-mountain-hero].is-final [data-hero-join] {
      animation: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-mountain-hero]');
  const phases = hero ? Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-phase]')) : [];
  const final = hero?.querySelector<HTMLElement>('[data-hero-final]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && phases.length && final) {
    const showFinal = () => {
      hero.classList.add('is-final');
      phases.forEach((item) => item.classList.add('opacity-0'));
    };

    if (reduceMotion) {
      showFinal();
    } else {
      phases.forEach((item, index) => {
        window.setTimeout(() => item.classList.remove('opacity-0'), index * 2500);
        window.setTimeout(() => item.classList.add('opacity-0'), index * 2500 + 1800);
      });
      window.setTimeout(showFinal, 7500);
    }
  }
</script>
