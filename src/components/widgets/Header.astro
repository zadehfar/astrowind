---
import { Icon } from 'astro-icon/components';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import SlideOutMenu from '~/components/widgets/SlideOutMenu.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  links?: Array<Link>;
}

export interface Props {
  id?: string;
  links?: Array<Link>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showSearch?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showSearch = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const isActive = (href?: string) => typeof href === 'string' && `/${trimSlash(href)}` === currentPath;
const persistKey = `header-${Array.from(
  JSON.stringify({ links, actions, isSticky, isDark, isFullWidth, showToggleTheme, showSearch, position })
)
  .reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) >>> 0, 7)
  .toString(36)}`;
---

<aw-header transition:persist={persistKey}>
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky, dark: isDark },
      'top-0 z-40 mx-auto w-full flex-none border-b border-gray-50/0 transition-[opacity] ease-in-out',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div class="absolute inset-0"></div>
    <div
      class:list={[
        'relative mx-auto flex w-full items-center justify-between px-4 py-4 text-default lg:px-8',
        { 'max-w-7xl': !isFullWidth },
      ]}
    >
      <a
        class="flex h-8 w-auto items-center transition-opacity hover:opacity-85 md:h-10"
        href={getHomePermalink()}
        aria-label="Savalan Institute home"
      >
        <img
          class="h-full w-auto object-contain dark:hidden"
          src="/assets/savalan-wordmark.png"
          alt="Savalan Institute"
        />
        <img
          class="hidden h-full w-auto object-contain dark:block"
          src="/assets/savalan-wordmark-dark.png"
          alt=""
          aria-hidden="true"
        />
      </a>
      <nav class="hidden flex-1 justify-center lg:flex" aria-label="Main navigation">
        <ul class="flex items-center gap-8">
          {
            links
              .filter(({ text }) => text !== 'Blog')
              .map(({ text, href, links: children }) => (
                <li>
                  {children?.length ? (
                    <button
                      type="button"
                      class="rounded-md px-3 py-2 text-lg font-medium transition duration-200 hover:bg-gray-200/50 hover:text-link dark:hover:bg-gray-700/50 dark:hover:text-white"
                      data-menu-category-trigger={text}
                    >
                      {text}
                    </button>
                  ) : (
                    <a
                      class:list={[
                        'rounded-md px-3 py-2 text-lg font-medium transition duration-200 hover:bg-gray-200/50 hover:text-link dark:hover:bg-gray-700/50 dark:hover:text-white',
                        { 'aw-link-active': isActive(href) },
                      ]}
                      href={href}
                    >
                      {text}
                    </a>
                  )}
                </li>
              ))
          }
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        {showToggleTheme && <ToggleTheme iconClass="h-5 w-5" />}
        {
          showSearch && (
            <button
              type="button"
              class="rounded-lg p-2.5 text-muted transition hover:bg-gray-100 dark:hover:bg-gray-700"
              aria-label="Search"
            >
              <Icon name="tabler:search" class="h-5 w-5" />
            </button>
          )
        }
        {
          actions.map(({ text, href, target }) => (
            <a
              class="cursor-pointer rounded-md border border-slate-900/15 px-4 py-2 text-sm font-semibold uppercase tracking-wide transition-all duration-200 ease-in-out hover:-translate-y-0.5 hover:bg-neutral-200 hover:shadow-md dark:border-white/20 dark:hover:bg-slate-700"
              href={href}
              target={target}
              rel={target === '_blank' ? 'noopener noreferrer' : undefined}
            >
              {text}
            </a>
          ))
        }
        <button
          type="button"
          class="flex h-12 w-12 items-center justify-center bg-slate-900 text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-primary"
          aria-label="Open menu"
          aria-expanded="false"
          data-menu-toggle
        >
          <Icon name="tabler:menu-2" class="h-6 w-6" />
        </button>
      </div>
    </div>
  </header>
  <SlideOutMenu links={links} />
</aw-header>

<style>
  aw-header {
    display: contents;
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('header');
      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          header.classList.toggle('scroll', window.scrollY > 60);
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }
      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
    }
  }

  if (!customElements.get('aw-header')) customElements.define('aw-header', AwHeader);
</script>
