---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showSearch?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showSearch = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

// Compare paths without trailing slashes so the active link is detected
// regardless of the `trailingSlash` setting (`getPermalink()` emits `/contact/`
// when it is enabled, while `currentPath` above never has one, see #557).
const isActive = (href?: string) => typeof href === 'string' && `/${trimSlash(href)}` === currentPath;

// The header is kept across view transitions (transition:persist) so its state
// survives client-side navigations. Astro matches persisted elements by name,
// so the name must change whenever the header content does: otherwise a page
// with its own menu (the demo homes, the landing pages) would keep showing the
// header of the page the visitor came from. Hash the props that shape the markup.
const persistKey = `header-${Array.from(
  JSON.stringify({ links, actions, isSticky, isDark, isFullWidth, showToggleTheme, showSearch, position })
)
  .reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) >>> 0, 7)
  .toString(36)}`;
---

<aw-header transition:persist={persistKey}>
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky, dark: isDark },
      'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div class="absolute inset-0"></div>
    <div
      class:list={[
        'relative text-default py-3 px-3 lg:px-6 mx-auto w-full',
        {
          'lg:flex lg:justify-between': position !== 'center',
        },
        {
          'lg:grid lg:grid-cols-3 lg:items-center': position === 'center',
        },
        {
          'max-w-7xl': !isFullWidth,
        },
      ]}
    >
      <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between lg:hidden']}>
        <a class="flex items-center" href={getHomePermalink()}>
          <Logo />
        </a>
        <div class="flex items-center lg:hidden">
          <ToggleMenu controls={`${id}-nav`} />
        </div>
      </div>
      <nav
        id={`${id}-nav`}
        class="fixed inset-y-0 left-0 z-50 flex w-80 max-w-[85vw] -translate-x-full transform pointer-events-none flex-col bg-page p-6 text-default shadow-xl transition-transform duration-300 ease-in-out lg:pointer-events-auto lg:static lg:z-auto lg:w-full lg:max-w-none lg:translate-x-0 lg:transform-none lg:bg-transparent lg:p-0 lg:shadow-none lg:transition-none lg:mx-0 lg:overflow-visible lg:justify-self-start"
        aria-label="Main navigation"
        aria-hidden="false"
        data-aw-sidebar
      >
        <div class="mb-6 flex items-center justify-between lg:hidden">
          <span class="text-lg font-semibold text-heading">Menu</span>
          <button
            type="button"
            class="rounded-lg p-2 text-muted transition hover:bg-gray-100 hover:text-heading focus:outline-none focus:ring-2 focus:ring-primary dark:hover:bg-gray-800"
            aria-label="Close menu"
            data-aw-close-menu
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 fill-none stroke-current stroke-2">
              <path d="m6 6 12 12M18 6 6 18"></path>
            </svg>
          </button>
        </div>
        <ul
          class="flex w-full flex-col text-xl font-medium tracking-[0.01rem] lg:w-auto lg:flex-row lg:self-center lg:justify-center lg:text-[0.9375rem]"
        >
          {
            links.map(({ text, href, links }) => (
              <li class={links?.length ? 'dropdown' : ''}>
                {links?.length ? (
                  <>
                    <button
                      type="button"
                      class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                    >
                      {text}{' '}
                      <Icon
                        name="tabler:chevron-down"
                        class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden lg:inline"
                      />
                    </button>
                    <ul class="dropdown-menu lg:backdrop-blur-md dark:lg:bg-slate-900 dark:lg:border dark:lg:border-slate-700/50 rounded lg:absolute pl-4 lg:pl-0 lg:hidden font-medium lg:bg-white/90 lg:min-w-[200px] drop-shadow-xl">
                      {links.map(({ text: text2, href: href2 }) => (
                        <li>
                          <a
                            class:list={[
                              'first:rounded-t last:rounded-b lg:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-nowrap',
                              { 'aw-link-active': isActive(href2) },
                            ]}
                            href={href2}
                          >
                            {text2}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap lg:justify-start lg:rounded-none lg:p-0 lg:font-normal lg:text-[1.7rem] lg:leading-none lg:tracking-[-0.04em] lg:text-white/90 lg:hover:text-white lg:py-3',
                      { 'aw-link-active': isActive(href) },
                    ]}
                    href={href}
                  >
                    {text}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <button
        type="button"
        class="fixed inset-0 z-40 hidden bg-black/40 opacity-0 transition-opacity duration-300 lg:hidden"
        aria-label="Close menu"
        data-aw-menu-overlay></button>
      <button
        type="button"
        class="fixed right-6 top-6 z-[60] hidden h-16 w-16 items-center justify-center bg-white text-slate-900 shadow-lg transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-white lg:flex"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls={`${id}-right-menu`}
        data-aw-right-toggle
      >
        <span class="sr-only">Open menu</span>
        <Icon name="tabler:menu-2" class="h-7 w-7" />
      </button>
      <aside
        id={`${id}-right-menu`}
        class="fixed inset-y-0 right-0 z-50 w-full max-w-md translate-x-full bg-[#0d5e9c] p-8 text-white shadow-2xl transition-transform duration-300 ease-in-out"
        aria-label="Site menu"
        aria-hidden="true"
        data-aw-right-menu
      >
        <div class="flex items-center justify-between">
          <span class="text-2xl font-semibold">Menu</span>
          <button
            type="button"
            class="flex h-12 w-12 items-center justify-center bg-white text-slate-900 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-white"
            aria-label="Close menu"
            data-aw-right-close
          >
            <Icon name="tabler:x" class="h-6 w-6" />
          </button>
        </div>
        <nav class="mt-16" aria-label="Expanded site menu">
          <ul class="space-y-7">
            {
              links.map(({ text, href }) => (
                <li>
                  <a
                    class:list={[
                      'block text-3xl font-medium tracking-tight text-white/90 transition hover:translate-x-2 hover:text-white',
                      { 'text-white': isActive(href) },
                    ]}
                    href={href}
                  >
                    {text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>
      <button
        type="button"
        class="fixed inset-0 z-40 hidden bg-slate-950/50 opacity-0 transition-opacity duration-300"
        aria-label="Close expanded menu"
        data-aw-right-overlay></button>
      <div
        class:list={[
          { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
          'hidden lg:self-center lg:flex items-center lg:mb-0 fixed w-full lg:w-auto lg:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 lg:p-0 lg:justify-self-end',
        ]}
      >
        <div class="items-center flex justify-between w-full lg:w-auto">
          <div class="flex">
            {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 lg:w-5 lg:h-5 lg:inline-block" />}
            {
              showSearch && (
                <button
                  type="button"
                  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label="Search"
                >
                  <Icon name="tabler:search" class="w-5 h-5" />
                </button>
              )
            }
          </div>
          {
            actions?.length ? (
              <span class="ml-4 rtl:ml-0 rtl:mr-4">
                {actions.map((btnProps) => (
                  <Button {...btnProps} class="ml-2 py-2.5 px-5.5 lg:px-6 font-semibold shadow-none text-sm w-auto" />
                ))}
              </span>
            ) : (
              ''
            )
          }
        </div>
      </div>
    </div>
  </header>
</aw-header>

<style>
  aw-header {
    display: contents;
  }

  @media (min-width: 1024px) {
    aw-header header {
      position: fixed;
      inset: 0 auto 0 0;
      width: min(28rem, 32vw);
      min-width: 18rem;
      height: 100vh;
      background: linear-gradient(180deg, #0d5e9c 0%, #0c4d82 100%);
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.04);
      z-index: 40;
    }

    aw-header header > div {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: flex-start;
      width: 100%;
      height: 100%;
      padding: 2.5rem 2rem 2rem;
    }

    aw-header header > div > div:first-child {
      display: none;
    }

    aw-header nav {
      position: static;
      width: 100%;
      max-width: none;
      transform: none;
      pointer-events: auto;
      background: transparent;
      box-shadow: none;
      padding: 0;
      margin-top: 2rem;
    }

    aw-header nav ul {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      width: 100%;
    }

    aw-header nav li {
      width: 100%;
    }

    aw-header nav a,
    aw-header nav button {
      width: 100%;
      justify-content: flex-start;
      padding: 0.15rem 0 !important;
      font-size: clamp(1.2rem, 2vw, 2.2rem);
      line-height: 1.2;
      letter-spacing: -0.04em;
      color: rgba(255, 255, 255, 0.9);
      font-weight: 500;
      text-align: left;
      transition: opacity 0.2s ease;
    }

    aw-header nav a:hover,
    aw-header nav button:hover,
    aw-header nav a.aw-link-active {
      color: #ffffff;
      opacity: 1;
    }

    aw-header nav a.aw-link-active {
      position: relative;
      padding-left: 0.75rem !important;
    }

    aw-header nav a.aw-link-active::before {
      content: '';
      position: absolute;
      left: -0.75rem;
      top: 0.2rem;
      width: 0.25rem;
      height: 100%;
      background: rgba(255, 255, 255, 0.9);
      border-radius: 999px;
    }

    aw-header nav li.dropdown {
      display: none;
    }

    aw-header [data-aw-menu-overlay],
    aw-header [data-aw-close-menu],
    aw-header .lg:hidden {
      display: none !important;
    }

    aw-header header > div > div:last-child {
      position: static;
      display: none;
    }

    aw-header [data-aw-right-toggle] {
      display: flex !important;
    }
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;
    private mql?: MediaQueryList;
    private onMqlChange?: () => void;
    private onPageLoad = () => {
      this.updateActiveLinks();
      this.closeOpenDropdown();
    };

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('header');
      const toggle = this.querySelector<HTMLElement>('[data-aw-toggle-menu]');
      const nav = this.querySelector<HTMLElement>('[data-aw-sidebar]');
      const close = this.querySelector<HTMLElement>('[data-aw-close-menu]');
      const overlay = this.querySelector<HTMLElement>('[data-aw-menu-overlay]');
      const lastChild = this.querySelector<HTMLElement>('header > div > div:last-child');
      const rightToggle = this.querySelector<HTMLElement>('[data-aw-right-toggle]');
      const rightMenu = this.querySelector<HTMLElement>('[data-aw-right-menu]');
      const rightClose = this.querySelector<HTMLElement>('[data-aw-right-close]');
      const rightOverlay = this.querySelector<HTMLElement>('[data-aw-right-overlay]');
      const isMobile = () => window.matchMedia('(max-width: 1023px)').matches;

      // The header persists across view transitions (transition:persist), so
      // the server-rendered `aw-link-active` class would go stale. Re-compute it
      // on every navigation (astro:page-load fires on load and after each swap).
      this.updateActiveLinks();
      document.addEventListener('astro:page-load', this.onPageLoad);
      nav?.setAttribute('aria-hidden', String(isMobile()));

      const closeMenu = () => {
        toggle?.classList.remove('expanded');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
        header?.classList.remove('h-screen', 'expanded', 'bg-page');
        nav?.setAttribute('aria-hidden', 'true');
        nav?.classList.add('pointer-events-none');
        nav?.classList.remove('pointer-events-auto');
        nav?.classList.remove('translate-x-0');
        nav?.classList.add('-translate-x-full');
        overlay?.classList.add('hidden');
        overlay?.classList.remove('opacity-100');
        overlay?.classList.add('opacity-0');
        lastChild?.classList.add('hidden');
      };

      // Mobile menu toggle.
      toggle?.addEventListener('click', () => {
        const expanded = toggle.classList.toggle('expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        document.body.classList.toggle('overflow-hidden');
        header?.classList.toggle('h-screen');
        header?.classList.toggle('expanded');
        header?.classList.toggle('bg-page');
        nav?.setAttribute('aria-hidden', String(!expanded));
        nav?.classList.toggle('pointer-events-none', !expanded);
        nav?.classList.toggle('pointer-events-auto', expanded);
        nav?.classList.toggle('-translate-x-full', !expanded);
        nav?.classList.toggle('translate-x-0', expanded);
        overlay?.classList.toggle('hidden', !expanded);
        requestAnimationFrame(() => overlay?.classList.toggle('opacity-100', expanded));
        lastChild?.classList.toggle('hidden');
      });

      close?.addEventListener('click', closeMenu);
      overlay?.addEventListener('click', closeMenu);

      // Close the mobile menu when a nav link is clicked.
      nav?.addEventListener('click', closeMenu);

      const closeRightMenu = () => {
        rightToggle?.setAttribute('aria-expanded', 'false');
        rightMenu?.setAttribute('aria-hidden', 'true');
        rightMenu?.classList.add('translate-x-full');
        rightMenu?.classList.remove('translate-x-0');
        rightOverlay?.classList.add('hidden');
        rightOverlay?.classList.remove('opacity-100');
        rightOverlay?.classList.add('opacity-0');
        document.body.classList.remove('overflow-hidden');
      };

      const openRightMenu = () => {
        rightToggle?.setAttribute('aria-expanded', 'true');
        rightMenu?.setAttribute('aria-hidden', 'false');
        rightMenu?.classList.remove('translate-x-full');
        rightMenu?.classList.add('translate-x-0');
        rightOverlay?.classList.remove('hidden');
        requestAnimationFrame(() => rightOverlay?.classList.add('opacity-100'));
        document.body.classList.add('overflow-hidden');
      };

      rightToggle?.addEventListener('click', openRightMenu);
      rightClose?.addEventListener('click', closeRightMenu);
      rightOverlay?.addEventListener('click', closeRightMenu);
      rightMenu?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) closeRightMenu();
      });

      // Desktop dropdowns open on hover/`:focus-within`. When a dropdown link is
      // clicked it keeps focus, and because the header uses `transition:persist`
      // the dropdown would stay open after the client-side navigation. Blur the
      // link on click so it closes right away (the `astro:page-load` handler is
      // the safety net if focus is restored during the swap).
      nav?.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement)?.closest<HTMLElement>('.dropdown-menu a');
        if (link) link.blur();
      });

      // Close it when leaving the mobile/tablet breakpoint (desktop nav starts at `lg`).
      this.mql = window.matchMedia('(max-width: 1023px)');
      this.onMqlChange = () => {
        if (isMobile()) {
          closeMenu();
          return;
        }
        nav?.setAttribute('aria-hidden', 'false');
        nav?.classList.remove('pointer-events-none', '-translate-x-full');
        nav?.classList.add('pointer-events-auto', 'translate-x-0');
        overlay?.classList.add('hidden');
        lastChild?.classList.remove('hidden');
      };
      this.mql.addEventListener('change', this.onMqlChange);

      // Sticky header: toggle the `scroll` class past a small threshold.
      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      if (this.mql && this.onMqlChange) this.mql.removeEventListener('change', this.onMqlChange);
      document.removeEventListener('astro:page-load', this.onPageLoad);
    }

    // With `transition:persist` the header (and its focus) survives client-side
    // navigations, so a clicked dropdown link keeps `:focus-within` and its menu
    // would stay open on the next page. Drop the focus so the CSS closes it.
    private closeOpenDropdown() {
      const active = document.activeElement as HTMLElement | null;
      if (active && this.contains(active) && active.closest('.dropdown')) active.blur();
    }

    private updateActiveLinks() {
      const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
      const current = norm(window.location.pathname);
      this.querySelectorAll<HTMLAnchorElement>('nav a[href]').forEach((a) => {
        const url = new URL(a.href, window.location.href);
        // Anchor-only links (`#`, `/#features`) resolve to the current page and
        // would light up everywhere; only path links can be "the current page".
        const isPathLink =
          url.origin === window.location.origin && !url.hash && !a.getAttribute('href')?.startsWith('#');
        a.classList.toggle('aw-link-active', isPathLink && norm(url.pathname) === current);
      });
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>
