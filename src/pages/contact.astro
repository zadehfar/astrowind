---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Engage & Get Involved | Savalan Institute',
  description: 'Join Savalan Institute in advancing policy research, civic initiatives, and community leadership.',
};

const opportunities = [
  [
    'Policy & Research Support',
    '3–5 hrs/week',
    'Help turn thoughtful research into accessible ideas that strengthen communities. Support literature reviews, briefs, and civic policy projects.',
  ],
  [
    'Event & Program Operations',
    'Project-based',
    'Bring Savalan gatherings and learning programs to life. Assist with planning, welcoming participants, and creating a thoughtful event experience.',
  ],
  [
    'Community Outreach & Advocacy',
    '2–4 hrs/week',
    'Build relationships with people and organizations working toward meaningful change. Help connect local voices with civic initiatives and opportunities.',
  ],
  [
    'Digital Communications & Media',
    'Flexible',
    'Help share Savalan stories with clarity and purpose. Contribute to editorial planning, social content, visual storytelling, or digital campaigns.',
  ],
];
---

<Layout metadata={metadata}>
  <main class="bg-[#f7f6f2] text-gray-900">
    <section class="px-6 py-16 md:px-16 md:py-24" aria-labelledby="engage-title">
      <div class="mx-auto max-w-7xl">
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-gray-600">Savalan Institute</p>
        <h1 id="engage-title" class="mt-6 max-w-4xl text-5xl font-bold tracking-tight md:text-7xl">
          Engage &amp; Get Involved
        </h1>
        <p class="mt-8 max-w-3xl font-serif text-2xl leading-relaxed md:text-3xl">
          Join Savalan Institute in driving impactful policy research, civic initiatives, and community leadership.
          Explore active volunteer roles below or reach out directly.
        </p>
      </div>
    </section>

    <section class="border-t border-gray-900/15 px-6 py-16 md:px-16 md:py-20" aria-labelledby="opportunities-title">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.25em] text-gray-600">Volunteer opportunities</p>
            <h2 id="opportunities-title" class="mt-3 text-3xl font-bold tracking-tight md:text-5xl">
              Find your way to contribute.
            </h2>
          </div>
          <a
            class="text-sm font-bold uppercase tracking-wide underline underline-offset-4 hover:no-underline"
            href="#application">Apply below →</a
          >
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-2">
          {
            opportunities.map(([title, commitment, description]) => (
              <article class="flex flex-col border border-gray-900/20 p-6 transition-all duration-200 hover:-translate-y-1 hover:bg-white hover:shadow-md md:p-8">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <h3 class="max-w-sm text-2xl font-bold tracking-tight">{title}</h3>
                  <span class="border border-gray-900/30 px-3 py-1 text-xs font-bold uppercase tracking-wide">
                    {commitment}
                  </span>
                </div>
                <p class="mt-5 max-w-xl text-base leading-relaxed text-gray-700">{description}</p>
                <button
                  class="mt-8 w-fit cursor-pointer border-b border-gray-900 pb-1 text-sm font-bold uppercase tracking-wide transition-all duration-200 hover:-translate-y-0.5"
                  type="button"
                  data-role={title}
                  data-apply-role
                >
                  Apply for this role →
                </button>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="application"
      class="border-t border-gray-900/15 px-6 py-16 md:px-16 md:py-20"
      aria-labelledby="application-title"
    >
      <div class="mx-auto grid max-w-7xl gap-12 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] md:gap-20 lg:gap-28">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.25em] text-gray-600">
            General inquiries &amp; applications
          </p>
          <h2 id="application-title" class="mt-4 text-4xl font-bold tracking-tight md:text-6xl">
            Start a conversation.
          </h2>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-gray-700">
            Tell us how you would like to connect. Every expression of interest helps us build a more engaged, informed,
            and generous civic community.
          </p>
        </div>

        <form
          class="flex flex-col gap-7"
          method="post"
          action="/contact/"
          aria-label="Savalan Institute engagement form"
        >
          <div class="grid gap-7 sm:grid-cols-2">
            <div>
              <label class="block text-lg font-bold" for="first-name"
                >First name <span aria-hidden="true">*</span></label
              ><input
                class="mt-2 block w-full border-0 border-b border-gray-900 bg-transparent px-0 py-3 outline-none focus:border-black focus:ring-0"
                id="first-name"
                name="first_name"
                type="text"
                autocomplete="given-name"
                required
              />
            </div>
            <div>
              <label class="block text-lg font-bold" for="last-name">Last name <span aria-hidden="true">*</span></label
              ><input
                class="mt-2 block w-full border-0 border-b border-gray-900 bg-transparent px-0 py-3 outline-none focus:border-black focus:ring-0"
                id="last-name"
                name="last_name"
                type="text"
                autocomplete="family-name"
                required
              />
            </div>
          </div>
          <div>
            <label class="block text-lg font-bold" for="email">Email <span aria-hidden="true">*</span></label><input
              class="mt-2 block w-full border-0 border-b border-gray-900 bg-transparent px-0 py-3 outline-none focus:border-black focus:ring-0"
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </div>
          <div class="grid gap-7 sm:grid-cols-2">
            <div>
              <label class="block text-lg font-bold" for="phone"
                >Phone number <span class="font-normal">(optional)</span></label
              ><input
                class="mt-2 block w-full border-0 border-b border-gray-900 bg-transparent px-0 py-3 outline-none focus:border-black focus:ring-0"
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
              />
            </div>
            <div>
              <label class="block text-lg font-bold" for="location">Zip Code / Location</label><input
                class="mt-2 block w-full border-0 border-b border-gray-900 bg-transparent px-0 py-3 outline-none focus:border-black focus:ring-0"
                id="location"
                name="location"
                type="text"
                autocomplete="postal-code"
              />
            </div>
          </div>
          <div>
            <label class="block text-lg font-bold" for="engagement-type"
              >How would you like to engage? <span aria-hidden="true">*</span></label
            >
            <select
              class="mt-2 block w-full border-0 border-b border-gray-900 bg-transparent px-0 py-3 outline-none focus:border-black focus:ring-0"
              id="engagement-type"
              name="engagement_type"
              required
              data-engagement-type
            >
              <option value="">Select an option</option><option value="General Inquiry">General Inquiry</option><option
                value="Volunteer Application">Volunteer Application</option
              ><option value="Partnership Request">Partnership Request</option>
            </select>
          </div>
          <fieldset class="hidden border-0 p-0" data-volunteer-interests>
            <legend class="text-lg font-bold">Volunteer area of interest <span aria-hidden="true">*</span></legend>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {
                ['Policy & Research', 'Event Coordination', 'Community Outreach', 'Digital & Content Creation'].map(
                  (interest) => (
                    <label class="flex items-center gap-3 text-base">
                      <>
                        <input
                          class="h-5 w-5 rounded-none border-gray-900 bg-transparent accent-gray-900 focus:ring-0"
                          name="volunteer_interests"
                          type="checkbox"
                          value={interest}
                          data-interest
                        />
                        <span>{interest}</span>
                      </>
                    </label>
                  )
                )
              }
            </div>
          </fieldset>
          <div>
            <label class="block text-lg font-bold" for="background">Background, skills &amp; availability</label>
            <textarea
              class="mt-2 block min-h-36 w-full resize-y border-0 border-b border-gray-900 bg-transparent px-0 py-3 outline-none focus:border-black focus:ring-0"
              id="background"
              name="background"
              placeholder="Briefly share your background, relevant skills, and general weekly availability."></textarea>
          </div>
          <label class="flex items-start gap-3 text-sm leading-relaxed"
            ><input
              class="mt-1 h-5 w-5 shrink-0 rounded-none border-gray-900 bg-transparent accent-gray-900 focus:ring-0"
              name="terms"
              type="checkbox"
              required
            /><span
              >Yes, I agree to the <a class="underline underline-offset-2 hover:no-underline" href="/terms/"
                >Terms of Service</a
              > and <a class="underline underline-offset-2 hover:no-underline" href="/privacy/">Privacy Policy</a
              >.</span
            ></label
          >
          <button
            class="w-full cursor-pointer border border-gray-900 bg-transparent px-8 py-3 text-sm font-bold uppercase tracking-wide transition-all duration-200 hover:-translate-y-0.5 hover:bg-gray-900 hover:text-white hover:shadow-md sm:ml-auto sm:w-fit"
            type="submit">Apply / Submit</button
          >
        </form>
      </div>
    </section>
  </main>
</Layout>

<script>
  const initContactPage = () => {
    const typeSelect = document.querySelector<HTMLSelectElement>('[data-engagement-type]');
    const interests = document.querySelector<HTMLElement>('[data-volunteer-interests]');
    const interestInputs = interests?.querySelectorAll<HTMLInputElement>('[data-interest]');
    const updateInterests = () => {
      const isVolunteer = typeSelect?.value === 'Volunteer Application';
      interests?.classList.toggle('hidden', !isVolunteer);
      interestInputs?.forEach((input) => (input.required = Boolean(isVolunteer)));
    };
    typeSelect?.addEventListener('change', updateInterests);
    document.querySelectorAll<HTMLButtonElement>('[data-apply-role]').forEach((button) => {
      button.addEventListener('click', () => {
        if (typeSelect) typeSelect.value = 'Volunteer Application';
        updateInterests();
        const target = Array.from(interestInputs ?? []).find((input) =>
          button.dataset.role?.startsWith(input.value.split(' & ')[0] ?? '')
        );
        if (target) target.checked = true;
        document.querySelector('#application')?.scrollIntoView({ behavior: 'smooth' });
      });
    });
    updateInterests();
  };
  document.addEventListener('astro:page-load', initContactPage);
  initContactPage();
</script>
